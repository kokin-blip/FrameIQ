  "narrative": {
    "northStar": "Fluent Docked Editor",
    "overview": "FrameIQ follows the approved Fluent Docked Editor direction: matte graphite surfaces, compact Inter typography, outlined icons, and restrained blue actions. Image inspection remains central, with direct access to frame identity and supporting controls.\n\nThe shared visual system applies to Studio, Library, Export, and Settings. Tonal surface steps and fine dividers organize information; imagery comes from imported media. The approved reference is docs/design/mockups/fluent-option-1.png. The previous Canvas/DesignCode world is superseded; its handoffs, captures, and earlier Figma pages remain historical references.",
    "keyCharacteristics": [
      "Opaque graphite surfaces with no decorative glow or blur.",
      "Compact Inter controls and tabular frame/time numerals.",
      "Docked tools with a large neutral image inspection canvas.",
      "Consistent outlined Lucide icons with a 1.6px stroke and distinct keyboard focus."
    ],
    "rules": [
      {
        "name": "Image Fit",
        "body": "Keep the inspection canvas opaque and fit the complete frame without distorting its aspect ratio. Zoom is relative to the fitted view.",
        "section": "colors"
      },
      {
        "name": "Flat at Rest",
        "body": "Separate docked surfaces with tone and borders. Reserve the panel shadow for the floating activity panel.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use shared tokens and preserve full-frame image fit on the opaque canvas.",
      "**Do** keep project context, exact frame identities, selections, and metadata accessible.",
      "**Do** distinguish approximate playback from resolved selection and export.",
      "**Do** preserve visible focus, labels, reduced motion, and factual Settings copy."
    ],
    "donts": [
      "**Don't** add decorative glow, gradients, blur, or translucent dock surfaces.",
      "**Don't** restore floating playback tools or collapsible selection/detail panels from the superseded Canvas composition.",
      "**Don't** add a permanent privacy shield or local-processing footer badge.",
      "**Don't** claim official Fluent kit imports; components are local editable adaptations.",
      "**Don't** present unavailable AI or shopping modules as enabled, or use invented result imagery."
    ]
  }
}
